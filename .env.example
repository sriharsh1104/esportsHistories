# Copy this file to .env.development, .env.stage, or .env.production
# and fill in the values. Never commit actual credentials.

# Environment: development | stage | production
APP_ENV=development

# API Configuration (same base for profile, geocode, etc. — no trailing slash)
# Reverse geocode: GET {API_BASE_URL}/geocode/reverse?lat=&lon=&acceptLanguage=en-IN
# If routes live under /api, include it here (e.g. http://localhost:5000/api).
API_BASE_URL=http://localhost:3000
API_TIMEOUT=30000

# Auth (if using a service)
AUTH_CLIENT_ID=
AUTH_REDIRECT_URI=

# Feature flags (optional)
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
